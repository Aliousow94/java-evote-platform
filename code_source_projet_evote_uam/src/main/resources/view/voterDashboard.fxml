<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.VoterDashboardController" stylesheets="@../css/style.css">

    <!-- Menu latéral gauche (Orange) -->
    <left>
        <VBox styleClass="sidebar" prefWidth="200" alignment="TOP_LEFT" spacing="20">
            <Text text="UAM e-Vote" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: white;"/>
            <Text fx:id="userInfoLabel" text="Bonjour," style="-fx-fill: white; -fx-font-size: 14px;"/>
            <Button text="🗳️ Élections Ouvertes" styleClass="sidebar-btn" maxWidth="Infinity" onAction="#showOpenElections"/>
            <Button text="📜 Résultats Archivés" styleClass="sidebar-btn" maxWidth="Infinity" onAction="#showArchivedResults"/>
            <Button text="🚪 Déconnexion" styleClass="sidebar-btn" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- Zone de contenu (Blanche) -->
    <center>
        <VBox fx:id="contentArea" styleClass="content-area" spacing="20">
            <Label text="Élections en cours" styleClass="dashboard-title"/>
            <TableView fx:id="electionsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="titreColumn" text="Titre de l'élection" prefWidth="250"/>
                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="150"/>
                    <TableColumn fx:id="dateFinColumn" text="Clôture le" prefWidth="150"/>
                </columns>
            </TableView>
            <!-- NOUVEAU BOUTON -->
            <HBox alignment="CENTER_RIGHT">
                <Button text="🗳️ Voter pour cette élection" styleClass="btn-primary" onAction="#handleVoter"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>